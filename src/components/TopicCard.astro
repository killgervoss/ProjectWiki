---
import type { CollectionEntry } from 'astro:content';
interface Props { topic: CollectionEntry<'topics'>; }
const { topic } = Astro.props;
---

<article
  class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"
  data-topic-card
  data-category={topic.data.category}
>
  <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-emerald-800">{topic.data.category}</p>
  <h2 class="mb-2 text-xl font-semibold">
    <a href={`/topics/${topic.id}/`} class="hover:underline">{topic.data.title}</a>
  </h2>
  <p class="mb-5 text-sm text-stone-500">{topic.data.sources.map(source => source.book).join(' · ')}</p>
  <details>
    <summary class="cursor-pointer text-sm font-medium text-emerald-800">Quick preview</summary>
    <p class="mt-3 leading-relaxed text-stone-600">{topic.data.summary}</p>
    <a href={`/topics/${topic.id}/`} class="mt-4 inline-block font-medium text-emerald-800 underline">Read full topic →</a>
  </details>
</article>
