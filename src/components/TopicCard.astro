---
import { topicPath, ui, type Lang } from '../i18n/ui';
import type { Topic } from '../lib/topics';
interface Props { topic: Topic; lang: Lang; }
const { topic, lang } = Astro.props;
const t = ui(lang);
---

<article class="topic-card" data-topic-card data-category={topic.data.category}
  data-books={JSON.stringify(topic.data.sources.map(source => source.book))}
  data-tags={JSON.stringify(topic.data.tags)}>
  <p class="category-badge">{topic.data.category}</p>
  <h2><a href={topicPath(lang, topic.data.topicKey)}>{topic.data.title}</a></h2>
  <p class="card-sources">{[...new Set(topic.data.sources.map(source => source.book))].join(' · ')}</p>
  <details>
    <summary>{t.preview}</summary>
    <p class="card-summary">{topic.data.summary}</p>
    <a href={topicPath(lang, topic.data.topicKey)} class="text-link">{t.readFull} →</a>
  </details>
</article>
