---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { brand } from '../lib/brand';
import { localePath, ui, type Lang } from '../i18n/ui';
import type { TranslationLinks } from '../lib/topics';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  languageLinks: TranslationLinks;
}
const { lang, title, languageLinks } = Astro.props;
const t = ui(lang);
const description = Astro.props.description ?? t.description;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const alternates = Object.entries(languageLinks);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#153a3d" />
    <title>{title} | {t.brand}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && alternates.map(([language, href]) => <link rel="alternate" hreflang={language} href={new URL(href!, Astro.site).href} />)}
    {Astro.site && <meta property="og:image" content={new URL(brand.emblem, Astro.site).href} />}
  </head>
  <body style={`--brand-mountains: url("${brand.mountains}"); --brand-waves: url("${brand.waves}");`}>
    <a href="#main" class="skip-link">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a href={localePath(lang)} class="brand-link" aria-label={t.brand}>
          <img src={brand.mark} alt="" width="1024" height="941" class="brand-mark" />
          <img src={brand.wordmark} alt="" width="1569" height="411" class="brand-wordmark" />
        </a>
        <div class="header-controls">
          <nav aria-label={t.mainNav} class="main-nav">
            <a href={localePath(lang)}>{t.topics}</a>
            <a href={localePath(lang, 'search/')} data-search-link>{t.search} <span class="keyboard-hint">Ctrl/⌘ K</span></a>
          </nav>
          <LanguageSwitcher lang={lang} links={languageLinks} />
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <a href={localePath(lang)} class="footer-lockup" aria-label={t.brand}>
          <img src={brand.lockup} alt="" width="1673" height="748" loading="lazy" />
        </a>
        <p>{t.description}</p>
      </div>
    </footer>
    <script>
      document.addEventListener('keydown', event => {
        if ((event.metaKey || event.ctrlKey) && (event.code === 'KeyK' || event.key.toLowerCase() === 'k')) {
          const link = document.querySelector<HTMLAnchorElement>('[data-search-link]');
          if (link) { event.preventDefault(); window.location.assign(link.href); }
        }
      });
    </script>
  </body>
</html>
