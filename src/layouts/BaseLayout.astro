---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Explore Buddhist concepts one topic at a time.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Open Knowledge</title>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:block focus:p-4">Skip to content</a>
    <header class="border-b border-stone-200 bg-white">
      <nav aria-label="Main navigation" class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5">
        <a href="/" class="text-lg font-semibold">Open Knowledge</a>
        <div class="flex gap-5 text-sm">
          <a href="/" class="hover:underline">Topics</a>
          <a href="/search/" class="hover:underline">Search <span class="hidden sm:inline">(Ctrl/⌘ K)</span></a>
        </div>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-5 py-10 sm:py-16">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl border-t border-stone-200 px-5 py-7 text-sm text-stone-600">
      Learning prototype · Example content requires source verification before publication.
    </footer>
    <script>
      // A small browser script. Code in the frontmatter above runs during rendering.
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          window.location.assign('/search/');
        }
      });
    </script>
  </body>
</html>
