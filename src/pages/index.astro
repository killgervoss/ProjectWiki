---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopicCard from '../components/TopicCard.astro';

const topics = (await getCollection('topics', ({ data }) => !data.draft))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const categories = [...new Set(topics.map(topic => topic.data.category))].sort();
---

<BaseLayout title="Explore topics">
  <div class="mb-10 max-w-2xl">
    <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-emerald-800">A growing library of ideas</p>
    <h1 class="mb-5 text-4xl font-semibold tracking-tight sm:text-5xl">Understand one concept at a time.</h1>
    <p class="text-lg leading-relaxed text-stone-600">Explore Buddhist ideas through independent topics. Open a quick preview, follow a connection, or settle into a longer read.</p>
  </div>

  <div class="mb-7 flex flex-wrap items-center justify-between gap-4">
    <p id="topic-count" role="status" class="text-sm text-stone-600">{topics.length} topics</p>
    <div id="category-control" hidden>
      <label for="category" class="mr-2 text-sm font-medium">Category</label>
      <select id="category" class="rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm">
        <option value="">All categories</option>
        {categories.map(category => <option value={category}>{category}</option>)}
      </select>
    </div>
  </div>
  <div class="grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {topics.map(topic => <TopicCard topic={topic} />)}
  </div>
  <p id="empty-state" hidden class="py-10 text-stone-600">No topics match this category.</p>
</BaseLayout>

<script>
  const control = document.querySelector<HTMLElement>('#category-control');
  const select = document.querySelector<HTMLSelectElement>('#category');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-topic-card]')];
  const count = document.querySelector<HTMLElement>('#topic-count');
  const empty = document.querySelector<HTMLElement>('#empty-state');
  if (control && select && count && empty) {
    control.hidden = false;
    const update = () => {
      let visible = 0;
      for (const card of cards) {
        card.hidden = Boolean(select.value && card.dataset.category !== select.value);
        if (!card.hidden) visible++;
      }
      count.textContent = `${visible} topic${visible === 1 ? '' : 's'}`;
      empty.hidden = visible > 0;
    };
    select.addEventListener('change', update);
    update();
  }
</script>
