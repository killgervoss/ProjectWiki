---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics', ({ data }) => !data.draft);
  const byId = new Map(topics.map(topic => [topic.id, topic]));
  return topics.map(topic => {
    const related = topic.data.relatedTopics.map(id => {
      const target = byId.get(id);
      if (!target) throw new Error(`${topic.id}: related topic "${id}" is missing or a draft.`);
      return { id: target.id, title: target.data.title };
    });
    return { params: { id: topic.id }, props: { topic, related } };
  });
}

interface Props {
  topic: CollectionEntry<'topics'>;
  related: { id: string; title: string }[];
}
const { topic, related } = Astro.props;
const { Content, headings } = await render(topic);
// An estimate based on raw Markdown; calculate once during the build.
const minutes = Math.max(1, Math.ceil((topic.body ?? '').split(/\s+/).filter(Boolean).length / 200));
const sections = headings.filter(heading => heading.depth === 2);
---

<BaseLayout title={topic.data.title} description={topic.data.summary}>
  <div class="mx-auto max-w-3xl">
    <a href="/" class="mb-8 inline-block text-sm text-emerald-800 underline">← All topics</a>
    <article data-pagefind-body>
      <header class="mb-8 border-b border-stone-200 pb-8">
        <p data-pagefind-filter="Category" class="mb-3 text-sm font-semibold text-emerald-800">{topic.data.category}</p>
        <h1 data-pagefind-meta="title" class="mb-4 text-4xl font-semibold tracking-tight">{topic.data.title}</h1>
        <p class="mb-4 text-lg leading-relaxed text-stone-600">{topic.data.summary}</p>
        <p data-pagefind-ignore class="text-sm text-stone-500">About {minutes} min read</p>
        {topic.data.aliases.length > 0 && <p class="mt-4 text-sm text-stone-600">Also known as: {topic.data.aliases.join(', ')}</p>}
        {topic.data.tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
          {topic.data.tags.map(tag => <li data-pagefind-filter="Tag" class="rounded-full bg-stone-100 px-3 py-1 text-xs">{tag}</li>)}
        </ul>}
      </header>
      {sections.length > 0 && <nav data-pagefind-ignore aria-label="On this page" class="mb-8 rounded-xl bg-stone-100 p-5">
        <p class="mb-2 font-semibold">On this page</p>
        <ul class="space-y-2 text-sm">{sections.map(heading => <li><a href={`#${heading.slug}`} class="text-emerald-800 underline">{heading.text}</a></li>)}</ul>
      </nav>}
      <div class="reader"><Content /></div>
      <section class="mt-10 border-t border-stone-200 pt-6" aria-labelledby="sources-heading">
        <h2 id="sources-heading" class="mb-3 text-xl font-semibold">Sources</h2>
        <ul class="space-y-3 text-sm leading-relaxed text-stone-600">
          {topic.data.sources.map(source => <li>
            <cite data-pagefind-filter="Book">{source.book}</cite> — {source.author}; {source.chapter}{source.pages ? `, pp. ${source.pages}` : ''}.
          </li>)}
        </ul>
      </section>
    </article>
    {related.length > 0 && <aside class="mt-10 rounded-xl border border-stone-200 p-6" aria-labelledby="related-heading">
      <h2 id="related-heading" class="mb-3 text-xl font-semibold">Related topics</h2>
      <ul class="space-y-2">{related.map(target => <li><a href={`/topics/${target.id}/`} class="text-emerald-800 underline">{target.title}</a></li>)}</ul>
    </aside>}
  </div>
</BaseLayout>
